{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oubliette",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    // Serves iframe.html at /iframe and index.html at /.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
